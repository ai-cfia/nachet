# RBAC Configuration
# UUID of CFIA organization - used to determine cross-organization authority
# CFIA admins (users with "admin" role in this org) can access all org data
CFIA_ORGANIZATION_ID=

# UUID of the "admin" role in CFIA organization (from rbac_role table)
# Used for efficient CFIA admin verification via direct rbac_user_role lookup
# Query: SELECT id FROM rbac_role WHERE name='admin' AND organization_id=<CFIA_ORGANIZATION_ID>
CFIA_ADMIN_ROLE_ID=

# UUID of the "user" role in CFIA organization (from rbac_role table)
# Used for user role assignments in CFIA organization
CFIA_USER_ROLE_ID=
