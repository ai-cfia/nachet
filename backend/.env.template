NACHET_AZURE_STORAGE_CONNECTION_STRING=
NACHET_STORAGE_URL=
NACHET_DATA=
NACHET_DB_URL=
NACHET_BLOB_PIPELINE_NAME=
NACHET_BLOB_PIPELINE_VERSION=
NACHET_BLOB_PIPELINE_DECRYPTION_KEY=
NACHET_BLOB_ACCOUNT=
NACHET_BLOB_KEY=
NACHET_MAX_CONTENT_LENGTH=
NACHET_VALID_EXTENSION=
NACHET_VALID_DIMENSION=

DEV_USER_EMAIL=
NACHET_ENV="local"
NACHET_FRONTEND_PUBLIC_URL=
NACHET_FRONTEND_DEV_URL=
BACKEND_DEV_PORT=5174
FRONTEND_DEV_PORT=5173

CORS_ALLOW_ORIGINS="http://localhost:5173,http://localhost:12436"
TRUSTED_HOSTS="localhost,"

DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
NACHET_SCHEMA=
TESTING=False

# Blob Storage Configuration
# Set BLOB_STORAGE_PROVIDER to "azure", "minio", or "s3"
BLOB_STORAGE_PROVIDER="azure"

# Azure Blob Storage Configuration (when BLOB_STORAGE_PROVIDER="azure")
BLOB_STORAGE_NAME=""
BLOB_STORAGE_KEY=""
BLOB_STORAGE_ENDPOINT_PROTOCOL="http"
BLOB_STORAGE_ENDPOINT_SUFFIX=""
BLOB_STORAGE_ENDPOINT_BASE=""

BLOB_STORAGE_EXTERNAL_NAME=""
BLOB_STORAGE_EXTERNAL_KEY=""
BLOB_STORAGE_EXTERNAL_ENDPOINT_PROTOCOL=""
BLOB_STORAGE_EXTERNAL_ENDPOINT_SUFFIX=""
BLOB_STORAGE_EXTERNAL_ENDPOINT_BASE=""

# Blob Container Prefix
# In azure Blob Storage, this is the name of the container
# In S3-compatible storage, this is the name of the bucket
# should end in a dash "-"
BLOB_CONTAINER_PREFIX="nachet-"

# S3 Configuration (when BLOB_STORAGE_PROVIDER="s3" or NO_AZURE_STORAGE="true")
# For Apache Ozone S3 Gateway: S3_ENDPOINT_URL="http://localhost:9878"
# For AWS S3: Leave S3_ENDPOINT_URL empty
S3_ENDPOINT_URL="http://localhost:9878"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
S3_USE_SSL="false"
S3_VERIFY="true"

# S3-only mode: bypass Azure storage and Defender scanning
# When set to "true":
# - All storage accounts (cloud, external, onprem) use S3-compatible storage
# - Azure Defender malware scanning is skipped (recorded as "skipped" in state)
# - Sanitization step still runs (extracts RGB pixels, removes metadata)
NO_AZURE_STORAGE="false"

# Unified timeout settings for all blob storage providers (Azure, S3, etc.)
BLOB_STORAGE_CONNECTION_TIMEOUT="5"
BLOB_STORAGE_READ_TIMEOUT="10"

SECURITY_HEADERS_PRESET="strict"

# Backend authentication
# Keep "azure" for the existing Microsoft Entra path. Use "oidc" for a
# provider configured through OIDC discovery. Authentication cannot be disabled.
AUTH_PROVIDER="azure"

# Microsoft Entra settings used when AUTH_PROVIDER="azure"
AZURE_CLIENT_ID="your-azure-client-id"
AZURE_TENANT_ID="your-tenant-id"
AZURE_API_SCOPE_CLAIM="scope.your-scope"

# OIDC settings used when AUTH_PROVIDER="oidc"
OIDC_ISSUER="http://keycloak.localhost:8080/realms/nachet"
OIDC_AUDIENCE="nachet-api"
OIDC_USER_ID_CLAIM="sub"
OIDC_USERNAME_CLAIM="preferred_username"
OIDC_EMAIL_CLAIM="email"
# Local development only: Keycloak start-dev serves metadata over HTTP.
# Keep HTTPS required in shared and deployed environments.
OIDC_REQUIRE_HTTPS_METADATA="false"

# Frontend Static Files Configuration
FRONTEND_BLOB_CONTAINER="frontend"
FRONTEND_VERSION_FILE="version.txt"

# OpenTelemetry Configuration
# Set OTEL_ENABLED to "true" to enable OpenTelemetry logging/tracing
# When disabled (default), logs will only go to console
OTEL_ENABLED="false"
OTEL_EXPORTER_PROTOCOL=grpc
OTEL_EXPORTER_ENDPOINT=http://alloy:4317
DBOS_EXPORTER_ENDPOINT=http://alloy:4318
LOG_LEVEL="INFO"

# RBAC Configuration
# UUID of CFIA organization - used to determine cross-organization authority
# CFIA admins (users with "admin" role in this org) can access all org data
CFIA_ORGANIZATION_ID=

# UUID of the "admin" role in CFIA organization (from rbac_role table)
# Used for efficient CFIA admin verification via direct rbac_user_role lookup
# Query: SELECT id FROM rbac_role WHERE name='admin' AND organization_id=<CFIA_ORGANIZATION_ID>
CFIA_ADMIN_ROLE_ID=

# UUID of the "user" role in CFIA organization (from rbac_role table)
# Used for user role assignments in CFIA organization
CFIA_USER_ROLE_ID=
