DB_USER=""
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT=12432
DB_NAME=""
NACHET_SCHEMA="nachet-backend-test"
TESTING=False

BLOB_STORAGE_PROVIDER="azure"
BLOB_STORAGE_NAME=""
BLOB_STORAGE_KEY=""
BLOB_STORAGE_ENDPOINT_PROTOCOL="http"
BLOB_STORAGE_ENDPOINT_SUFFIX=""
BLOB_STORAGE_ENDPOINT_BASE=""

BLOB_STORAGE_EXTERNAL_NAME=""
BLOB_STORAGE_EXTERNAL_KEY=""
BLOB_STORAGE_EXTERNAL_ENDPOINT_PROTOCOL=""
BLOB_STORAGE_EXTERNAL_ENDPOINT_SUFFIX=""
BLOB_STORAGE_EXTERNAL_ENDPOINT_BASE=""

# Blob Container Prefix
# In azure Blob Storage, this is the name of the container
# In S3-compatible storage, this is the name of the bucket
# should end in a dash "-"
BLOB_CONTAINER_PREFIX="nachet-"

S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION_NAME=""
S3_ENDPOINT_URL=""
S3_USE_SSL="false"
S3_VERIFY="false"

# Unified timeout settings for all blob storage providers (Azure, S3, etc.)
# Shorter timeouts for tests
BLOB_STORAGE_CONNECTION_TIMEOUT="2"
BLOB_STORAGE_READ_TIMEOUT="3"

SECURITY_HEADERS_PRESET="strict"

# Backend authentication
AUTH_PROVIDER="azure"

# Microsoft Entra settings used when AUTH_PROVIDER="azure"
AZURE_CLIENT_ID="your-azure-client-id"
AZURE_TENANT_ID="your-tenant-id"
AZURE_API_SCOPE_CLAIM="scope.your-scope"

# OIDC settings used when AUTH_PROVIDER="oidc"
OIDC_ISSUER=""
OIDC_AUDIENCE=""
OIDC_USER_ID_CLAIM="sub"
OIDC_USERNAME_CLAIM="preferred_username"
OIDC_EMAIL_CLAIM="email"
OIDC_CA_BUNDLE=""

# Frontend Static Files Configuration
FRONTEND_BLOB_CONTAINER="frontend"
FRONTEND_VERSION_FILE="version.txt"

CORS_ALLOW_ORIGINS="http://localhost:12436,"
TRUSTED_HOSTS="localhost,"

# Required for datastore tests
NACHET_STORAGE_URL="DefaultEndpointsProtocol=http;AccountName=[account];AccountKey=[key];BlobEndpoint=http://localhost:12434/[account];"
NACHET_BLOB_ACCOUNT="[account]"
NACHET_BLOB_KEY="[key]"
DEV_USER_EMAIL="test.user@inspection.gc.ca"

# Required environment variables for app.py
NACHET_AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=[account];AccountKey=[key];BlobEndpoint=http://localhost:12434/[account];"
NACHET_DATA="https://raw.githubusercontent.com/ai-cfia/nachet-data/main/"
NACHET_ENV="local"
NACHET_VALID_EXTENSION="["jpeg", "jpg", "png", "gif", "bmp", "tiff", "webp"]"
NACHET_VALID_DIMENSION="{"width": 1920, "height": 1080}"
NACHET_MAX_CONTENT_LENGTH="16"

# OpenTelemetry Configuration
# Disabled for tests to avoid connection errors
OTEL_ENABLED="false"
OTEL_EXPORTER_PROTOCOL=grpc
OTEL_EXPORTER_ENDPOINT=http://alloy:4317
DBOS_EXPORTER_ENDPOINT=http://alloy:4318
LOG_LEVEL="INFO"

# RBAC Configuration
# UUID of CFIA organization - used to determine cross-organization authority
# CFIA admins (users with "admin" role in this org) can access all org data
CFIA_ORGANIZATION_ID=
CFIA_ADMIN_ROLE_ID=
CFIA_USER_ROLE_ID=
