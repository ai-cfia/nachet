{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "terraform": {
    "ignorePaths": []
  },
  "packageRules": [
    {
      "matchDepTypes": ["*"],
      "rangeStrategy": "bump"
    },
    
    {
      "matchManagers": ["terraform"],
      "matchFileNames": ["terraform/**/*.tf"],
      "commitMessageTopic": "Terraform {{depName}}",
      "groupName": "Terraform providers",
      "matchDepTypes": ["provider", "required_provider"]
    },

    {
      "matchManagers": ["terraform"],
      "matchFileNames": ["terraform/**/*.tf"],
      "matchDepTypes": ["module"],
      "groupName": "Terraform modules"
    },

    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend non-major dependencies",
      "groupSlug": "frontend-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["frontend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "backend non-major dependencies",
      "groupSlug": "backend-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["backend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "frontend workflows major dependencies",
      "groupSlug": "frontend-workflows-major",
      "matchPackageNames": ["*"],
      "matchFileNames": [".github/workflows/frontend-*"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "backend workflows major dependencies",
      "groupSlug": "backend-workflows-major",
      "matchPackageNames": ["*"],
      "matchFileNames": [".github/workflows/backend-*"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "frontend major dependencies",
      "groupSlug": "frontend-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["frontend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "backend major dependencies",
      "groupSlug": "backend-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["backend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "other minor dependencies",
      "groupSlug": "other-minor",
      "matchPackageNames": ["*"],
      "matchFileNames": ["*"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "other major dependencies",
      "groupSlug": "other-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["*"]
    }
  ]
}
