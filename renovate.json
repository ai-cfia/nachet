{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "gitIgnoredAuthors": [
    "github-actions[bot]",
    "actions-user@users.noreply.github.com",
    "actions-user"
  ],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend non-major dev dependencies",
      "groupSlug": "frontend-dev-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["frontend/**"]
    },

    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "nachet-mini non-major dev dependencies",
      "groupSlug": "nachet-mini-dev-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["nachet-mini/**"]
    },

    {
      "matchDepTypes": ["dependency-groups.dev"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "backend non-major dev dependencies",
      "groupSlug": "backend-dev-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["backend/**"]
    },
    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "frontend non-major dependencies",
      "groupSlug": "frontend-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["frontend/**"]
    },
    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "nachet-mini non-major dependencies",
      "groupSlug": "nachet-mini-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["nachet-mini/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "backend non-major dependencies",
      "groupSlug": "backend-minor-patch",
      "matchPackageNames": ["*"],
      "matchFileNames": ["backend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "frontend workflows major dependencies",
      "groupSlug": "frontend-workflows-major",
      "matchPackageNames": ["*"],
      "matchFileNames": [".github/workflows/frontend-*"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "backend workflows major dependencies",
      "groupSlug": "backend-workflows-major",
      "matchPackageNames": ["*"],
      "matchFileNames": [".github/workflows/backend-*"]
    },

    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "frontend major dev dependencies",
      "groupSlug": "frontend-dev-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["frontend/**"]
    },

    {
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "nachet-mini major dev dependencies",
      "groupSlug": "nachet-mini-dev-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["nachet-mini/**"]
    },

    {
      "matchDepTypes": ["dependency-groups.dev"],
      "matchUpdateTypes": ["major"],
      "groupName": "backend major dev dependencies",
      "groupSlug": "backend-dev-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["backend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "frontend major dependencies",
      "groupSlug": "frontend-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["frontend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "backend major dependencies",
      "groupSlug": "backend-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["backend/**"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "other minor dependencies",
      "groupSlug": "other-minor",
      "matchPackageNames": ["*"],
      "matchFileNames": ["*"]
    },

    {
      "matchDepTypes": ["*"],
      "matchUpdateTypes": ["major"],
      "groupName": "other major dependencies",
      "groupSlug": "other-major",
      "matchPackageNames": ["*"],
      "matchFileNames": ["*"]
    }
  ],

  "minimumReleaseAge": "1 week"
}
