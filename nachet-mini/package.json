{
  "name": "nachet-mini",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prestart": "ts-appversion",
    "prebuild": "prettier \"src/**/*.{ts,tsx,js,jsx,json,css}\" -l --write ; eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && tsc",
    "build": "export $(grep -v '^#' .env.config.local | xargs) && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix && tsc --noEmit",
    "lint:md": "prettier \"docs/**/*.md\" -l --write && markdownlint-cli2 \"docs/**/*.md\" --fix --config ../.markdownlint-cli2.jsonc",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "playwright:install-deps": "npx playwright install-deps"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@huggingface/transformers": "^3.8.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "file-saver": "^2.0.5",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8",
    "react-webcam": "^7.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@saithodev/ts-appversion": "^2.2.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
