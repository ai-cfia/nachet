{
  "name": "nachet-frontend",
  "private": true,
  "version": "0.9.27",
  "acia-cfia": {
    "backend-version": "1.0.2"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prestart": "ts-appversion",
    "prebuild": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && tsc",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "playwright:install-deps": "npx playwright install-deps"
  },
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@saithodev/ts-appversion": "^2.2.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "axios": "^1.11.0",
    "browser-image-compression": "^2.0.2",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "js-base64": "^3.7.7",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "pako": "^2.1.0",
    "re-resizable": "^6.11.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-draggable": "^4.5.0",
    "react-icons": "^5.5.0",
    "react-picture-annotation": "^1.2.0",
    "react-router-dom": "^7.8.0",
    "react-webcam": "^7.2.0",
    "serve": "^14.2.4",
    "styled-components": "^6.1.19",
    "typescript": "^5.9.2",
    "utif": "^3.1.0",
    "uuid": "^9.0.1",
    "web-vitals": "^5.1.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@cyclonedx/cyclonedx-npm": "^4.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.19.10",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/utif": "^3.0.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^30.0.5",
    "node-fetch": "^3.3.2",
    "playwright": "^1.54.2",
    "prettier": "3.6.2",
    "vite": "^7.1.1",
    "vite-plugin-environment": "^1.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "npm": "^11.5.2",
    "node": "^24.5.0"
  },
  "overrides": {
    "esbuild": "^0.25.8",
    "on-headers": "^1.1.0",
    "cross-spawn": "^7.0.6"
  }
}
