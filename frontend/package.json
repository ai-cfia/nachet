{
  "name": "nachet-frontend",
  "private": true,
  "version": "2.9.17",
  "acia-cfia": {
    "backend-version": "2.9.4"
  },
  "type": "module",
  "scripts": {
    "update": "rm -r node_modules && npm install && npx cyclonedx-npm package-lock.json --output-reproducible --package-lock-only -v --sv 1.6 -o sbom.json && echo \"\" >> sbom.json",
    "build:oidc-client-ts": "npm ci --prefix ./submodules/oidc-client-ts --ignore-scripts && npm run build --prefix ./submodules/oidc-client-ts",
    "dev": "vite",
    "prestart": "ts-appversion",
    "prebuild": "prettier \"src/**/*.{ts,tsx,js,jsx,json,css}\" -l --write && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && tsc",
    "build": "export $(grep -v '^#' .env.config.local | xargs) && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 --fix && tsc --noEmit",
    "lint:md": "prettier \"docs/**/*.md\" -l --write && markdownlint-cli2 \"docs/**/*.md\" --fix --config ../.markdownlint-cli2.jsonc",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "playwright:install-deps": "npx playwright install-deps"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.22.1",
    "@azure/msal-react": "^3.0.19",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@saithodev/ts-appversion": "^2.2.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "axios": "^1.12.0",
    "browser-image-compression": "^2.0.2",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "re-resizable": "^6.11.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-draggable": "^4.5.0",
    "react-i18next": "^16.2.3",
    "react-icons": "^5.5.0",
    "react-picture-annotation": "^1.2.0",
    "react-router-dom": "^7.8.0",
    "react-webcam": "^7.2.0",
    "sanitize-html": "^2.17.0",
    "serve": "^14.2.4",
    "styled-components": "^6.0.3",
    "typescript": "^5.9.2",
    "utif": "^3.1.0",
    "uuid": "^13.0.0",
    "web-vitals": "^5.1.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.33.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@types/utif": "^3.0.5",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^30.0.5",
    "markdownlint-cli2": "^0.22.0",
    "node-fetch": "^3.3.2",
    "playwright": "^1.54.2",
    "prettier": "3.8.3",
    "vite": "^7.1.1",
    "vite-plugin-environment": "^1.1.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "npm": "^11.5.2",
    "node": "^24.5.0"
  },
  "overrides": {
    "esbuild": "^0.28.0",
    "on-headers": "^1.1.0",
    "cross-spawn": "^7.0.6"
  }
}
