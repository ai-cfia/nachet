PUBLIC_URL=.
VITE_BACKEND_URL="http://localhost:5174"
VITE_LOG_API_URL="http://localhost:5174/logs"
VITE_APP_MODE=
FRONTEND_DEV_PORT=5173

# OAuth 2.0 / Azure AD Configuration
VITE_AUTH_PROVIDER="msal"
VITE_AZURE_CLIENT_ID="your-azure-client-id"
VITE_AZURE_APP_ID_URI="api://your-app-id-uri"
VITE_AZURE_API_SCOPE_CLAIM="/scope.your-scope"
VITE_AZURE_AUTHORITY="https://login.microsoftonline.com/your-tenant-id"
VITE_AZURE_REDIRECT_URI="http://localhost:5173"
VITE_AZURE_POST_LOGOUT_REDIRECT_URI="http://localhost:5173"

# Provider-neutral OIDC adapter configuration.
# Set VITE_AUTH_PROVIDER="oidc" to use this path.
VITE_OIDC_AUTHORITY="http://keycloak.localhost:8080/realms/nachet"
VITE_OIDC_CLIENT_ID="nachet-frontend"
VITE_OIDC_SCOPE="openid profile email"
VITE_OIDC_API_SCOPE_CLAIM="nachet-api"
VITE_OIDC_REDIRECT_URI="http://localhost:5173"
VITE_OIDC_POST_LOGOUT_REDIRECT_URI="http://localhost:5173"
