# Dev Environment Configuration
project_name        = "nachet"
environment         = "dev"
location            = "canadacentral"
resource_group_name = "nachet-dev-rg"

# Network Configuration (Required - VNet must exist in same RG, subnets will be created)
vnet_name                  = "my-vnet"
container_apps_subnet_cidr = "10.0.1.0/26"  # 59 usable IPs for Container Apps
postgresql_subnet_cidr     = "10.0.2.0/28"  # 11 usable IPs for PostgreSQL
app_gateway_subnet_cidr    = "10.0.4.0/27"  # 27 usable IPs for Application Gateway
# storage_subnet_cidr      = "10.0.3.0/29"  # Optional: 3 usable IPs for Storage private endpoints
enable_public_access       = false  # Container Apps private, accessible via App Gateway

# Container Images
backend_image    = "ghcr.io/ai-cfia/nachet-backend:dev"
triton_image     = "nvcr.io/nvidia/tritonserver:24.10-py3"

# PostgreSQL Configuration
postgresql_admin_username = "nachetadmin"
postgresql_admin_password = "YourDevPasswordHere123!"
postgresql_sku_name       = "B_Standard_B2ms"
postgresql_storage_mb     = 32768
postgresql_version        = "16"

# Container Apps Resources
container_app_cpu    = 0.5
container_app_memory = "1Gi"
triton_cpu           = 2
triton_memory        = "4Gi"

# Backend Environment Variables
nachet_azure_storage_connection_string = "DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net"
nachet_data_path                       = "/app/data"
backend_port                           = "8080"

# ML Model Endpoints (Leave empty to use local Triton servers)
ml_model_endpoint_rcnn         = ""
ml_model_endpoint_swin         = ""
ml_model_endpoint_swin_22_spp  = ""
ml_model_endpoint_swin_27_spp  = ""

# ML Model API Keys
ml_api_key = ""

# Application Security
jwt_secret      = "dev-jwt-secret-here"
session_secret  = "dev-session-secret-here"
encryption_key  = "dev-encryption-key-here"

# Application Configuration
cors_allowed_origins = "*"
log_level            = "DEBUG"

# Azure Storage for Triton Models (Leave empty to use generated storage account key)
azure_storage_account_key = ""

# Additional Database URLs (Leave empty to use default)
fertiscan_db_url = ""

# Tags
tags = {
  Environment = "dev"
  Project     = "nachet"
  ManagedBy   = "Terraform"
  Department  = "CFIA"
}
